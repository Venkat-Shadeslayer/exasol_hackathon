SCHOLARMOTION_ENV=development
DATABASE_URL=postgresql+asyncpg://scholarmotion:scholarmotion@localhost:5432/scholarmotion
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=./projects
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=scholarmotion
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
MAIN_LLM_PROVIDER=mock
MAIN_LLM_API_KEY=
MAIN_LLM_MODEL=deterministic-v1
MAIN_LLM_BASE_URL=
MAIN_LLM_TEMPERATURE=0.2
VISUAL_LLM_PROVIDER=
VISUAL_LLM_API_KEY=
VISUAL_LLM_MODEL=
# TTS_PROVIDER: mock | openai_compatible | elevenlabs | kokoro_http
# For elevenlabs: TTS_API_KEY is your xi-api-key, TTS_MODEL is a model id (e.g.
# eleven_flash_v2_5), TTS_VOICE is an ElevenLabs voice_id (default: Rachel).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=deterministic-v1
TTS_BASE_URL=
TTS_VOICE=alloy
# For a locally hosted Kokoro-82M server:
# TTS_PROVIDER=kokoro_http
# TTS_BASE_URL=http://127.0.0.1:8811
# TTS_VOICE=af_heart
# Exasol backs the source corpus and its analytics (primary analytical platform).
# EXASOL_USE_UDF=true deploys a Python UDF for cosine similarity; if the instance
# refuses script creation, retrieval falls back to pure-SQL dot product.
EXASOL_ENABLED=true
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=SCHOLARMOTION
EXASOL_USE_UDF=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
MAX_CONCURRENT_SCENES=4
MAX_RENDER_WORKERS=2
MAX_LLM_REQUESTS=4
RENDER_TIMEOUT_SECONDS=180
FFMPEG_BINARY=ffmpeg
MANIM_BINARY=manim
CELERY_TASK_ALWAYS_EAGER=false
